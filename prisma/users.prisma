model User {
  id                  String     @id @default(uuid())
  name                String?
  email               String     @unique
  firebaseUid         String?    @unique @map("firebase_uid")
  roleId              String?    @map("role_id")
  role                Role?      @relation(fields: [roleId], references: [id])
  status              UserStatus @default(INVITED)
  invitedAt           DateTime?  @map("invited_at")
  invitationExpiresAt DateTime?  @map("invitation_expires_at")
  invitedById         String?    @map("invited_by_id")
  lastLogin           DateTime?  @map("last_login")
  tokenVersion        Int        @default(0) @map("token_version")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  invitedBy    User?            @relation("UserInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedUsers User[]           @relation("UserInvitedBy")
  permissions  UserPermission[]

  createdProjects     Project[]      @relation("ProjectCreatedBy")
  updatedProjects     Project[]      @relation("ProjectUpdatedBy")
  updatedPortfolios   Portfolio[]    @relation("PortfolioUpdatedBy")
  updatedPublications Publication[]  @relation("PublicationUpdatedBy")
  updatedSettings     SiteSettings[] @relation("SiteSettingsUpdatedBy")
  activityLogs        ActivityLog[]  @relation("ActivityLogActor")

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  users User[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  key         String  @unique
  name        String
  description String?

  userPermissions UserPermission[]

  @@map("permissions")
}

model UserPermission {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@map("user_permissions")
}

enum UserStatus {
  INVITED
  ACTIVE
  INACTIVE
}
