enum PublicationType {
  SALE
  LINK
  DOI
}

model Publication {
  id             String          @id @default(uuid())
  projectId      String          @unique @map("project_id")
  slug           String          @unique
  coverMediaId   String?         @unique @map("cover_media_id")
  type           PublicationType
  authors        String[]        @default([])
  editionNumber  String?         @map("edition_number")
  format         String?
  collection     String?
  measures       String?
  presentation   String?
  audience       String?
  language       String?
  isbn           String?
  sku            String?
  price          Decimal?        @db.Decimal(10, 2)
  compareAtPrice Decimal?        @map("compare_at_price") @db.Decimal(10, 2)
  quantity       Int?            @map("quantity")
  currency       String?         @default("MXN")
  externalUrl    String?         @map("external_url")
  isPublished    Boolean         @default(false) @map("is_published")
  publishedAt    DateTime?       @map("published_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  updatedById    String?         @map("updated_by_id")

  project    Project              @relation(fields: [projectId], references: [id])
  coverMedia ProjectMedia?        @relation(fields: [coverMediaId], references: [id])
  updatedBy  User?                @relation("PublicationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  sections   PublicationSection[]

  @@map("publications")
}

model PublicationSection {
  id            String   @id @default(uuid())
  publicationId String   @map("publication_id")
  label         String
  sortOrder     Int      @map("sort_order")
  pdfMediaId    String   @unique @map("pdf_media_id")
  createdAt     DateTime @default(now()) @map("created_at")

  publication Publication  @relation(fields: [publicationId], references: [id])
  pdfMedia    ProjectMedia @relation(fields: [pdfMediaId], references: [id])

  @@index([publicationId, sortOrder])
  @@map("publication_sections")
}
