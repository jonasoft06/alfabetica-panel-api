enum MediaScope {
  PORTFOLIO
  PUBLICATION
}

enum MediaType {
  IMAGE
  PDF
}

enum MediaStatus {
  PENDING
  CONFIRMED
}

model ProjectMedia {
  id           String      @id @default(uuid())
  projectId    String      @map("project_id")
  scope        MediaScope
  type         MediaType
  status       MediaStatus @default(PENDING)
  storageKey   String      @map("storage_key")
  // Client-side file name, kept for display only; the stored object is always
  // named after the media id.
  originalName String?     @map("original_name")
  alt          String?
  caption      String?
  displayOrder Int?        @map("display_order")
  mimeType     String      @map("mime_type")
  sizeBytes    Int         @map("size_bytes")
  width        Int?
  height       Int?
  createdAt    DateTime    @default(now()) @map("created_at")
  confirmedAt  DateTime?   @map("confirmed_at")

  project               Project             @relation(fields: [projectId], references: [id])
  portfolioCover        Portfolio?
  publicationCover      Publication?
  publicationSectionPdf PublicationSection?

  @@index([projectId, scope, displayOrder])
  @@map("project_media")
}
