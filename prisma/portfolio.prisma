model Portfolio {
  id           String    @id @default(uuid())
  projectId    String    @unique @map("project_id")
  slug         String    @unique
  coverMediaId String?   @unique @map("cover_media_id")
  isPublished  Boolean   @default(false) @map("is_published")
  displayOrder Int?      @map("display_order")
  publishedAt  DateTime? @map("published_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedById  String?   @map("updated_by_id")

  project    Project       @relation(fields: [projectId], references: [id])
  coverMedia ProjectMedia? @relation(fields: [coverMediaId], references: [id])
  updatedBy  User?         @relation("PortfolioUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("portfolios")
}
