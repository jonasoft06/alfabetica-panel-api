NODE_ENV=development
PORT=4000

# PostgreSQL (DigitalOcean Managed Database)
DATABASE_URL=
SHADOW_DATABASE_URL=

# Firebase Admin SDK (service account JSON, base64 encoded)
FIREBASE_SERVICE_ACCOUNT_B64=
ALLOWED_EMAIL_DOMAIN=

# JWT (min 64 chars each)
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=12h

# Break-glass superadmin (required in production)
SUPERADMIN_FIREBASE_UID=

# DigitalOcean Spaces
SPACES_ACCESS_KEY_ID=
SPACES_SECRET_ACCESS_KEY=
SPACES_BUCKET=
SPACES_REGION=
SPACES_ENDPOINT=
SPACES_CDN_URL=

# Seed only — read by prisma/seed.ts, never by the app
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
